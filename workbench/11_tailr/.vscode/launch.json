  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in library 'tailr'",
      "cargo": {
        "args": ["test", "--no-run", "--lib", "--package=tailr"],
        "filter": {
          "name": "tailr",
          "kind": "lib"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'tailr'",
      "cargo": {
        "args": ["build", "--bin=tailr", "--package=tailr"],
        "filter": {
          "name": "tailr",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in executable 'tailr'",
      "cargo": {
        "args": ["test", "--no-run", "--bin=tailr", "--package=tailr"],
        "filter": {
          "name": "tailr",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug integration test 'cli'",
      "cargo": {
        "args": ["test", "--no-run", "--test=cli", "--package=tailr"],
        "filter": {
          "name": "cli",
          "kind": "test"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  ]
}
